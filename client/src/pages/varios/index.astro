---
// src/pages/varios.astro
import BaseLayout from '@/layouts/BaseLayout.astro'; 
import VariosCard from '@/components/VariosCard.astro';
import { listAnimes } from '@/lib/varios';

const varios = await listAnimes();
---

<BaseLayout title="Animes Varios — Ania Starlight">
    <section class="section-pad" style="padding-top: calc(var(--nav-h) + 60px)">
        <div class="container">
            <div class="section-label">Fuera de temporada</div>
            <h2 class="section-title">Animes <span class="accent-c">Varios</span></h2>

            <div class="filters" id="animeFilters">
                <button class="filter-btn active" data-filter="all"
                    >Todos</button
                >
                <button class="filter-btn" data-filter="watching">Viendo</button
                >
                <button class="filter-btn" data-filter="completed"
                    >Completados</button
                >
                <button class="filter-btn" data-filter="upcoming"
                    >Próximamente</button
                >
            </div>

            <!-- Grid — renderizado en servidor, filtrado en cliente -->
            <div class="anime-grid" id="animeGrid">
                {
                    varios.map((vario) => (
                        <div data-status={vario.status}>
                            <VariosCard varios={vario} />
                        </div>
                    ))
                }
            </div>
        </div>
    </section>
</BaseLayout>

<script>
  function setupAnimeFilters() {
    const btns = document.querySelectorAll<HTMLElement>("#animeFilters .filter-btn");

    const items = document.querySelectorAll<HTMLElement>("#animeGrid [data-status]");

    if (!btns.length || !items.length) return;

    btns.forEach((btn) => {
      btn.addEventListener("click", () => {
        btns.forEach((b) => b.classList.remove("active"));
        btn.classList.add("active");

        const filter = btn.dataset.filter ?? "all";

        items.forEach((item) => {
          item.style.display =
            filter === "all" || item.dataset.status === filter
              ? ""
              : "none";
        });
      });
    });
  }

  document.addEventListener("astro:page-load", setupAnimeFilters);
</script>