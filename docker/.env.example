DOMAIN=localhost
PORT=80

DISCORD_URL=https://discord.gg/wMfwxyMXXY
X_URL=https://x.com/AniaStarlight
YT_URL=https://www.youtube.com/@AniaStarLight
TW_URL=https://www.twitch.tv/aniastarlight

# Change all secrets before production.
MONGO_INITDB_ROOT_USERNAME=CHANGE_ME_MONGO_USER
MONGO_INITDB_ROOT_PASSWORD=CHANGE_ME_MONGO_PASSWORD
MONGO_INITDB_DATABASE=ania
# Docker compose sets MONGO_URI with replicaSet=rs0 (required for transactions).
# Outside compose, use e.g.:
# MONGO_URI=mongodb://CHANGE_ME_MONGO_USER:CHANGE_ME_MONGO_PASSWORD@172.20.0.100:27017/ania?authSource=admin&replicaSet=rs0

SERVER_HOSTNAME=0.0.0.0
COOKIE_SECRET=CHANGE_ME_COOKIE_SECRET
JWT_SECRET=CHANGE_ME_JWT_SECRET
# in seconds
JWT_EXPIRES_IN=3600

# S3
S3_REGION=garage
S3_BUCKET=ania-s3-bucket
S3_ENDPOINT=http://172.20.0.104:3900
# URL pública para presigned URLs (navegador).
# Si no se define, se usa S3_ENDPOINT (válido en local).
# S3_PUBLIC_ENDPOINT=https://<dominio>

# Credenciales S3 (setear en tu entorno real; aquí solo de ejemplo)
AWS_ACCESS_KEY_ID=CHANGE_ME_AWS_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=CHANGE_ME_AWS_SECRET_KEY

# Normalmente NO se usa con garage
# AWS_SESSION_TOKEN=optional-session-token
